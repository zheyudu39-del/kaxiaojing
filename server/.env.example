# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交

# ===== 必填 =====
# JWT 签名密钥。缺失会导致服务启动失败。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== 服务 =====
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ===== 数据库 =====
DB_PATH=./data/competition.db

# ===== AI 助手（DeepSeek）=====
DEEPSEEK_API_KEY=

# ===== 邮件（QQ 邮箱示例）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：这里是邮箱「授权码」，不是登录密码
SMTP_PASS=

# ===== 数据库自动备份 =====
BACKUP_CRON=0 2 * * *
BACKUP_DIR=./data/backups
BACKUP_MAX=7

# ===== 限流 =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
